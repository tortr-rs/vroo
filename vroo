#!/bin/sh
# vroo: the compiler is a claude agent. FILE.vroo goes in, C comes out, cc builds it.
#   vroo FILE.vroo [-o OUT]    translate and build (the C is kept in .vroo-cache, reused until the source changes)
#   vroo -c FILE.vroo          print the C, build nothing
#   vroo make [FILE.vmake]     build a project: the .vmake and the files it names go to the agent as one program
#   -t LANG, VROO_TARGET or "target : LANG" in a .vmake picks the language to translate to: c (default), rust, go, python, zig
# VROO_UNITS=1 translates a source of more than 40 lines one function at a time, so an edit only re-translates the function it touched. experimental: a small model sometimes writes the same function twice.
die() { echo "vroo: $*" >&2; exit 1; }
cache=.vroo-cache
jobs=4
mkdir -p "$cache"

TARGET=${VROO_TARGET:-c}
flagged=
n=$#
while [ "$n" -gt 0 ]; do
	a=$1; shift; n=$((n - 1))
	if [ "$a" = -t ]; then TARGET=${1:?-t needs a language}; flagged=1; shift; n=$((n - 1)); else set -- "$@" "$a"; fi
done
case $TARGET in
c) T=C99; EXT=c
	INC='use its actual C headers, with the real file names and include paths (for example #include <X11> means <X11/Xlib.h>, <X11/Xutil.h> and <X11/keysym.h>, and #include <ncurses> means <ncurses.h>),'
	LINKNOTE=' Put one comment on the very first line of the C that lists every linker flag the program needs for the libraries it uses, like /* link: -lraylib -lm */, or /* link: */ if it needs none.' ;;
cpp|c++) TARGET=cpp; T=C++17; EXT=cpp
	INC='use its actual C++ or C headers, with the real file names and include paths (for example #include <X11> means <X11/Xlib.h>, <X11/Xutil.h> and <X11/keysym.h>),'
	LINKNOTE=' Put one comment on the very first line that lists every linker flag the program needs for the libraries it uses, like /* link: -lraylib -lm */, or /* link: */ if it needs none.' ;;
rust) T=Rust; EXT=rs ;;
go) T=Go; EXT=go ;;
python|py) TARGET=python; T='Python 3'; EXT=py; SHEBANG='/usr/bin/env python3' ;;
lua) T=Lua; EXT=lua; SHEBANG='/usr/bin/env lua' ;;
ruby|rb) TARGET=ruby; T=Ruby; EXT=rb; SHEBANG='/usr/bin/env ruby' ;;
perl|pl) TARGET=perl; T=Perl; EXT=pl; SHEBANG='/usr/bin/env perl' ;;
javascript|js|node) TARGET=javascript; T='JavaScript for Node.js'; EXT=js; SHEBANG='/usr/bin/env node' ;;
php) T=PHP; EXT=php; SHEBANG='/usr/bin/env php' ;;
bash) T=Bash; EXT=sh; SHEBANG='/usr/bin/env bash' ;;
sh|shell) TARGET=shell; T='POSIX sh'; EXT=sh; SHEBANG='/bin/sh' ;;
zig) T=Zig; EXT=zig ;;
fortran|f90) TARGET=fortran; T='Fortran 2018'; EXT=f90 ;;
ocaml|ml) TARGET=ocaml; T=OCaml; EXT=ml ;;
haskell|hs) TARGET=haskell; T=Haskell; EXT=hs ;;
nim) T=Nim; EXT=nim ;;
d) T=D; EXT=d ;;
swift) T=Swift; EXT=swift ;;
java) T=Java; EXT=java
	LINKNOTE=' The one public class must be called Main, with the main method in it.' ;;
kotlin|kt) TARGET=kotlin; T=Kotlin; EXT=kt ;;
dart) T=Dart; EXT=dart ;;
crystal|cr) TARGET=crystal; T=Crystal; EXT=cr ;;
v) T='V'; EXT=v ;;
odin) T=Odin; EXT=odin ;;
pascal|pas) TARGET=pascal; T='Free Pascal'; EXT=pas ;;
cobol|cob) TARGET=cobol; T='COBOL (free format)'; EXT=cob ;;
julia|jl) TARGET=julia; T=Julia; EXT=jl; SHEBANG='/usr/bin/env julia' ;;
r) T=R; EXT=R; SHEBANG='/usr/bin/env Rscript' ;;
elixir|exs) TARGET=elixir; T='Elixir script'; EXT=exs; SHEBANG='/usr/bin/env elixir' ;;
erlang|erl) TARGET=erlang; T='Erlang escript'; EXT=erl; SHEBANG='/usr/bin/env escript' ;;
tcl) T=Tcl; EXT=tcl; SHEBANG='/usr/bin/env tclsh' ;;
awk) T=AWK; EXT=awk; SHEBANG='/usr/bin/env -S awk -f' ;;
lisp|sbcl) TARGET=lisp; T='Common Lisp'; EXT=lisp; SHEBANG='/usr/bin/env -S sbcl --script' ;;
scheme|guile|scm) TARGET=scheme; T='Guile Scheme'; EXT=scm; SHEBANG='/usr/bin/env -S guile -s
!#' ;;
typescript|ts|deno) TARGET=typescript; T='TypeScript for Deno'; EXT=ts; SHEBANG='/usr/bin/env -S deno run -A' ;;
*) die "unknown target $TARGET: c c++ rust go zig java kotlin swift dart crystal v odin nim d pascal fortran cobol ocaml haskell | python lua ruby perl javascript typescript php bash sh julia r elixir erlang tcl awk lisp scheme" ;;
esac
[ -n "${INC:-}" ] || INC="use its real $T packages or imports, with their real names,"

ask() { # ask SYSTEM-PROMPT: stdin is what to translate, stdout the answer
	if [ -n "${VROO_API_URL:-}" ]; then
		[ -n "${VROO_MODEL:-}" ] || die "set VROO_MODEL for $VROO_API_URL"
		src=$(cat)
		SYS=$1 SRC=$src python3 -I -c '
import json, os
print(json.dumps({"model": os.environ["VROO_MODEL"], "temperature": 0,
  "messages": [{"role": "system", "content": os.environ["SYS"]}, {"role": "user", "content": os.environ["SRC"]}]}))' |
		curl -fsS "$VROO_API_URL" -H "Content-Type: application/json" -H "Authorization: Bearer ${VROO_API_KEY:-none}" -d @- |
		python3 -I -c '
import json, sys
d = json.load(sys.stdin)
print(d["choices"][0]["message"]["content"])' || die "the api call failed"
	else
		command -v claude >/dev/null || die "needs claude code, or set VROO_API_URL, VROO_MODEL and VROO_API_KEY"
		claude -p --model "${VROO_CLAUDE_MODEL:-haiku}" --tools "" --no-session-persistence --system-prompt "$1" || die "the agent failed"
	fi
}

strip() { # drop a code fence if the agent wrapped its answer in one
	sed -e '/^```/d'
}

LOOSE='Everyone writes vroo differently and the language has no strict rules, so your job is to guess what the author meant and translate that. Typos, odd spellings, missing braces, loose syntax and names that are never declared are all fine: infer them from the context and from comments (a name like dir_names after a directory was opened means the names in that directory; a comment on a line says what it should do). Fill in what is implied so the program works the way it was clearly meant to. Some lines are random gibberish typed just for fun, like (d,;j[sys]), only to make the code look real: do not translate them, do not guess what they mean, and do not complain about them, just skip them as if they were not there. The one thing you must not do is change what the author wrote on purpose: do not drop statements, do not reorder them, do not add features nobody asked for. Never stop with an error: always give a program that builds. When a name or function is not defined, infer from its name and the code around it what it was meant to do; if you really cannot tell, make it do nothing and leave a /* vroo: guessed */ comment there.'

LANG='The syntax is loose and braces based. Variables are untyped in the source, so infer their types. "or err { ... }" after a call that can fail is the failure branch and err holds the error text. "defer f()" runs f when the function returns. "for x in xs { }" loops over a list. io.print joins its arguments and writes them to stdout; it is vroo'"'"'s own name, so use the real way of printing in '"$T"', never a function called io.print. #include <name.vrh> pulls in a vroo header; for the standard ones (io, os) use the '"$T"' standard library. Any other #include <name> names a real library: '"$INC"' whatever the vroo include is called.'"$LINKNOTE"' A function that starts with "when ..." runs whenever that condition holds, nobody calls it. If the source has no main, write one that runs the top-level when blocks in the order they appear in the file, and keeps looping if one of them waits for keys or input.'

SYS_C="You are the compiler for a language called vroo. You are given vroo source and you reply with one $T program and nothing else: no explanation, no markdown fence. $LANG $LOOSE Output only the $T code."

SYS_P=' The input can be several files, each starting with a line ===== name =====. The first is a .vmake that says what the program is called and which files are its parts; the .vrh files describe what the parts share. All of them together are ONE program: reply with one single '"$T"' file that has one main, the one the .vmake says.'

SYS_H="You are the compiler for a language called vroo, working on one function at a time. You are given a whole vroo program. Reply with only its C99 preamble: the #includes, type definitions, global variables and small helpers, then a prototype for every function in the source and for main, written with the types you infer. Write NO function bodies at all: every function appears only as a prototype that ends with a semicolon, and the preamble must not contain a single line that opens a function body with a brace. No explanation, no markdown fence. $LANG $LOOSE"

SYS_U="You are the compiler for a language called vroo, working on one function at a time. You are given the C99 preamble that is already written, the whole vroo program for context, and then ONE unit of it to translate. Reply with only the complete C definition of that unit, matching its prototype in the preamble. Do not repeat the preamble and do not write any other function. No explanation, no markdown fence. $LANG $LOOSE"

SYS_N="You are the compiler for a language called vroo, working on one function at a time. You are given the C99 preamble that is already written and the whole vroo program. The program has no main. Reply with only the C definition of int main(int argc, char **argv) that runs the top-level when blocks as described. No explanation, no markdown fence. $LANG"

EXTRA=
libs() { # libs FILE.c: the link flags the agent asked for, or a guess from the includes
	l=$(sed -n 's|^/\* *link: *\(.*[^ ]\) *\*/ *$|\1|p' "$1" | tr '\n' ' ')
	[ -n "$l" ] && { echo "$l"; return; }
	grep -q -e '<ncurses.h>' -e '<curses.h>' "$1" && { pkg-config --libs ncursesw 2>/dev/null || pkg-config --libs ncurses 2>/dev/null || echo -lncurses; }
	grep -q '<X11/' "$1" && echo -lX11
	grep -q '<math.h>' "$1" && echo -lm
	grep -q '<pthread.h>' "$1" && echo -pthread
}

finish() { # finish FILE OUT: build what the agent wrote with the toolchain of the target
	case $TARGET in
	c) cc -Wall -o "$2" "$1" $(libs "$1") ;;
	rust) rustc -o "$2" "$1" ;;
	go) go build -o "$2" "$1" ;;
	zig) zig build-exe -femit-bin="$2" "$1" ;;
	cpp) c++ -std=c++17 -Wall -o "$2" "$1" $(libs "$1") ;;
	fortran) gfortran -o "$2" "$1" ;;
	ocaml) ocamlfind ocamlopt -o "$2" "$1" ;;
	haskell) ghc -o "$2" "$1" ;;
	nim) nim c -o:"$2" "$1" ;;
	d) ldc2 -of="$2" "$1" ;;
	swift) swiftc -o "$2" "$1" ;;
	java) # a class called Main in Main.java, the program is a script that runs it
		mkdir -p "$2.d" && cp "$1" "$2.d/Main.java" && javac -d "$2.d" "$2.d/Main.java" &&
		printf '#!/bin/sh\nexec java -cp "%s" Main "$@"\n' "$(cd "$2.d" && pwd)" > "$2" && chmod +x "$2" ;;
	kotlin) kotlinc "$1" -include-runtime -d "$2.jar" &&
		printf '#!/bin/sh\nexec java -jar "%s" "$@"\n' "$(cd "$(dirname "$2.jar")" && pwd)/$(basename "$2.jar")" > "$2" && chmod +x "$2" ;;
	dart) dart compile exe "$1" -o "$2" ;;
	crystal) crystal build "$1" -o "$2" ;;
	v) v -o "$2" "$1" ;;
	odin) odin build "$1" -file -out:"$2" ;;
	pascal) fpc -o"$2" "$1" ;;
	cobol) cobc -x -free -o "$2" "$1" ;;
	*) # the scripting languages: the program is the script, with a shebang on top
		{ echo "#!$SHEBANG"; cat "$1"; } > "$2" && chmod +x "$2" ;;
	esac || die "$TARGET failed, what the agent wrote is in $1"
}

hash() { sha256sum | cut -d' ' -f1; }

# cached SYSTEM-PROMPT FILE-WITH-THE-INPUT OUTPUT: asks unless the answer for this prompt and input is already in the cache
cached() {
	k=$( (printf '%s' "$1"; cat "$2") | hash)
	if [ ! -f "$cache/$k" ]; then
		ask "$1" < "$2" | strip > "$cache/$k.tmp" || exit 1
		[ -s "$cache/$k.tmp" ] || die "the agent gave back nothing"
		mv "$cache/$k.tmp" "$cache/$k"
	fi
	cp "$cache/$k" "$3"
}

# build_c FILE: the C for a whole source on stdout. small sources go in one request, big ones a function at a time
build_c() {
	all=$1; sys=$2
	mkdir -p "$cache"
	if [ -z "${VROO_UNITS:-}" ] || [ "$TARGET" != c ] || [ "$(wc -l < "$all")" -le 40 ]; then
		t=$(mktemp); cached "$sys" "$all" "$t"; cat "$t"; rm -f "$t"
		return
	fi
	tmp=$(mktemp -d)
	pre=$tmp/pre
	cached "$SYS_H$EXTRA" "$all" "$pre"
	if grep -q -e ')[ 	]*{' -e '^[ 	]*{' "$pre"; then # the model wrote bodies into the preamble: give up on units, one request
		echo "vroo: the preamble came back with function bodies, translating the whole source in one request" >&2
		rm -rf "$tmp"
		t=$(mktemp); cached "$sys" "$all" "$t"; cat "$t"; rm -f "$t"
		return
	fi
	# cut the source into units: a unit starts at a line in column 0 once the braces are balanced again
	awk -v dir="$tmp" '
		function start(   f) { n++; f = sprintf("%s/u%04d", dir, n); return f }
		BEGIN { n = 0; depth = 0; out = start() }
		{
			line = $0
			if (depth <= 0 && line ~ /^[^ \t}\/#]/ && n > 0 && seen) { out = start(); seen = 0 }
			print line > out
			if (line ~ /^[^ \t}\/#]/) seen = 1
			c = line; sub(/\/\/.*/, "", c)
			o = gsub(/{/, "{", c); cl = gsub(/}/, "}", c); depth += o - cl
		}' "$all"
	i=0
	for u in "$tmp"/u*; do
		grep -q -v -e '^#' -e '^[ 	]*$' -e '^[ 	]*//' "$u" || continue
		{ echo "===== C PREAMBLE ====="; cat "$pre"; echo; echo "===== WHOLE PROGRAM ====="; cat "$all"; echo; echo "===== TRANSLATE ONLY THIS UNIT ====="; cat "$u"; } > "$u.req"
		( cached "$SYS_U$EXTRA" "$u.req" "$u.c" ) &
		i=$((i + 1))
		[ $((i % jobs)) = 0 ] && wait
	done
	wait
	{
		cat "$pre"; echo
		for u in "$tmp"/u*; do [ -f "$u.c" ] && { cat "$u.c"; echo; }; done
		if ! grep -q 'main *(' "$all"; then
			{ echo "===== C PREAMBLE ====="; cat "$pre"; echo; echo "===== WHOLE PROGRAM ====="; cat "$all"; } > "$tmp/main.req"
			cached "$SYS_N$EXTRA" "$tmp/main.req" "$tmp/main.c" && cat "$tmp/main.c"
		fi
	}
	rm -rf "$tmp"
}

case ${1:-} in
make)
	vm=${2:-$(ls ./*.vmake 2>/dev/null | head -1)}
	[ -f "$vm" ] || die "no .vmake file"
	dir=$(dirname "$vm")
	prog=$(sed -n 's/^program *: *//p' "$vm" | head -1)
	[ -n "$prog" ] || prog=$(basename "$(cd "$dir" && pwd)")
	# the .vmake names the parts; every .vroo and .vrh in its folder that it mentions goes to the agent with it
	# a .vmake that names no file, or says "all the files" or "everything", takes every one in the folder
	everything=1
	for f in "$dir"/*.vroo "$dir"/*.vrh; do [ -f "$f" ] && grep -qF "$(basename "$f")" "$vm" && everything=; done
	grep -qi -E 'all( the)? files|every ?file|everything' "$vm" && everything=1
	all=$(mktemp)
	{
		echo "===== $(basename "$vm") ====="; cat "$vm"
		for f in "$dir"/*.vroo "$dir"/*.vrh; do
			[ -f "$f" ] || continue
			[ -n "$everything" ] || grep -qF "$(basename "$f")" "$vm" || continue
			echo; echo "===== $(basename "$f") ====="; cat "$f"
		done
	} > "$all"
	if [ -z "$flagged" ]; then # a "target : lang" line in the .vmake, unless -t was given
		t=$(sed -n 's/^target *: *//p' "$vm" | head -1)
		[ -n "$t" ] && [ "$t" != "$TARGET" ] && { rm -f "$all"; exec "$0" -t "$t" make "$vm"; }
	fi
	EXTRA=$SYS_P
	build_c "$all" "$SYS_C$SYS_P" > "$cache/last.$EXT" || exit 1
	rm -f "$all"
	finish "$cache/last.$EXT" "$dir/$prog"
	# "install : DIR" or "install to DIR" copies the finished program there
	inst=$(sed -n 's/^install *: *//p' "$vm" | head -1)
	[ -n "$inst" ] || inst=$(sed -n 's/.*install \(to\|into\) \([^ ]*\).*/\2/p' "$vm" | head -1)
	case $inst in "~"*) inst=$HOME${inst#"~"};; esac
	if [ -n "$inst" ]; then
		mkdir -p "$inst" || die "cannot make $inst"
		for x in "$dir/$prog" "$dir/$prog.d" "$dir/$prog.jar"; do
			if [ -e "$x" ]; then cp -R "$x" "$inst/" || die "cannot copy $x to $inst"; fi
		done
		echo "$inst/$prog"
	else
		echo "$dir/$prog"
	fi
	;;
-c)
	f=${2:?usage: vroo -c FILE.vroo}
	[ -f "$f" ] || die "$f: no such file"
	build_c "$f" "$SYS_C"
	;;
'')
	die "usage: vroo FILE.vroo [-o OUT] | vroo -c FILE.vroo | vroo make [FILE.vmake]"
	;;
*)
	src=$1; shift
	[ -f "$src" ] || die "$src: no such file"
	out=${src%.vroo}
	[ "${1:-}" = -o ] && out=$2
	mkdir -p "$cache"
	build_c "$src" "$SYS_C" > "$cache/last.$EXT" || exit 1
	finish "$cache/last.$EXT" "$out"
	echo "$out"
	;;
esac
